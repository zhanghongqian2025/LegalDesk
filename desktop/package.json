{
  "name": "@civright/legaldesk-desktop",
  "version": "0.3.0",
  "private": true,
  "description": "LegalDesk desktop installer powered by the DeepSeek Harness Web profile",
  "type": "module",
  "main": "src/main.mjs",
  "license": "MIT",
  "author": "北京赋界科技有限公司",
  "scripts": {
    "start": "npm run icons && electron .",
    "icons": "node scripts/generate-icons.mjs",
    "pack": "npm run icons && electron-builder --dir",
    "dist:mac": "npm run icons && electron-builder --mac dmg pkg zip && npm run checksums",
    "dist:win": "npm run icons && electron-builder --win nsis zip && npm run checksums",
    "checksums": "node scripts/checksums.mjs",
    "smoke:packaged": "node scripts/smoke-packaged.mjs"
  },
  "dependencies": {
    "@civright/legaldesk-harness": "file:../harness/legaldesk-harness",
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/dsh": "0.1.0-rc.8",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.0-rc.8",
    "@deepseek-ai/dsh-atomic-write": "0.1.0-rc.8",
    "@deepseek-ai/dsh-bash-local": "0.1.0-rc.8",
    "@deepseek-ai/dsh-code-runtime": "0.1.0-rc.8",
    "@deepseek-ai/dsh-compaction": "0.1.0-rc.8",
    "@deepseek-ai/dsh-fs": "0.1.0-rc.8",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.8",
    "@deepseek-ai/dsh-output-retention": "0.1.0-rc.8",
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.8",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session-telemetry": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session-title-llm": "0.1.0-rc.8",
    "@deepseek-ai/dsh-shell": "0.1.0-rc.8",
    "@deepseek-ai/dsh-spill": "0.1.0-rc.8",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.0-rc.8",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.8",
    "@deepseek-ai/dsh-workflow": "0.1.0-rc.8"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "sharp": "0.35.3"
  },
  "optionalDependencies": {
    "@img/sharp-darwin-arm64": "0.35.3",
    "@img/sharp-darwin-x64": "0.35.3",
    "@img/sharp-libvips-darwin-arm64": "1.3.2",
    "@img/sharp-libvips-darwin-x64": "1.3.2",
    "@img/sharp-win32-x64": "0.35.3",
    "@koromix/koffi-darwin-arm64": "3.1.6",
    "@koromix/koffi-darwin-x64": "3.1.6",
    "@koromix/koffi-win32-x64": "3.1.6",
    "@vscode/ripgrep-darwin-arm64": "1.18.0",
    "@vscode/ripgrep-darwin-x64": "1.18.0",
    "@vscode/ripgrep-win32-x64": "1.18.0",
    "@xberg-io/xberg-darwin-arm64": "1.0.14",
    "@xberg-io/xberg-win32-x64-msvc": "1.0.14",
    "node-addon-require-builtin-darwin-arm64": "0.1.5",
    "node-addon-require-builtin-darwin-x64": "0.1.5",
    "node-addon-require-builtin-win32-x64-msvc": "0.1.5"
  },
  "build": {
    "appId": "cn.fujie.legaldesk",
    "productName": "LegalDesk",
    "copyright": "Copyright © 2026 北京赋界科技有限公司",
    "artifactName": "LegalDesk-${version}-${os}-${arch}.${ext}",
    "asar": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json",
      "!**/*.map",
      "!release/**/*"
    ],
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "pkg",
        "zip"
      ]
    },
    "dmg": {
      "title": "LegalDesk ${version}",
      "sign": false
    },
    "pkg": {
      "allowAnywhere": false,
      "allowCurrentUserHome": true,
      "allowRootDirectory": false
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "LegalDesk",
      "uninstallDisplayName": "LegalDesk",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Office"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "npmRebuild": false
  }
}
